{
  "name": "provenance-ui",
  "private": true,
  "version": "0.2.0",
  "description": "Codex-desktop-style web UI for Provenance, driving `provenance app-server` over a local WebSocket bridge.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node server/main.ts --open",
    "start": "node server/main.ts --prod",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "gen:protocol": "node scripts/gen-protocol.ts",
    "smoke": "node scripts/smoke.ts",
    "e2e": "node scripts/e2e.ts",
    "e2e:setup": "node scripts/setup-e2e.ts",
    "e2e:accounts": "node scripts/accounts-e2e.ts",
    "e2e:router": "node scripts/router-e2e.ts",
    "check:fallback": "node scripts/fallback-check.ts",
    "check:orchestrator": "node scripts/orchestrator-check.ts",
    "e2e:welcome": "node scripts/welcome-e2e.ts",
    "e2e:toolgroup": "node scripts/toolgroup-e2e.ts",
    "e2e:subagents": "node scripts/subagents-e2e.ts",
    "e2e:carry": "node scripts/carry-e2e.ts",
    "check:presence": "node scripts/presence-check.ts",
    "mock:router": "node scripts/mock-router.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:electron": "node scripts/build-electron.mjs",
    "app:dev": "node scripts/build-electron.mjs && PROVENANCE_APP_VITE=1 electron .",
    "app:start": "npm run build && node scripts/build-electron.mjs && electron .",
    "app:build": "npm run build && node scripts/build-electron.mjs && node scripts/fetch-browser.ts && node scripts/fetch-router.ts && node scripts/fetch-agent.ts && electron-builder --mac --arm64 --publish never",
    "app:build:mac": "npm run build && node scripts/build-electron.mjs && node scripts/fetch-browser.ts && node scripts/fetch-router.ts && node scripts/fetch-agent.ts && electron-builder --mac --arm64 --publish never",
    "app:build:mac:x64": "npm run build && node scripts/build-electron.mjs && node scripts/fetch-browser.ts && node scripts/fetch-router.ts && node scripts/fetch-agent.ts && electron-builder --mac --x64 --publish never",
    "app:build:win": "npm run build && node scripts/build-electron.mjs && node scripts/fetch-browser.ts && node scripts/fetch-router.ts && node scripts/fetch-agent.ts && electron-builder --win --x64 --publish never",
    "app:build:linux": "npm run build && node scripts/build-electron.mjs && node scripts/fetch-browser.ts && node scripts/fetch-router.ts && node scripts/fetch-agent.ts && electron-builder --linux --x64 --publish never",
    "browser:fetch": "node scripts/fetch-browser.ts",
    "router:fetch": "node scripts/fetch-router.ts",
    "agent:fetch": "node scripts/fetch-agent.ts",
    "app:install": "node scripts/install-app.mjs",
    "app:e2e": "node scripts/app-e2e.ts",
    "app:check:router": "node scripts/app-router-check.ts",
    "app:check:fresh": "node scripts/app-fresh-check.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "main": "build-electron/main.cjs",
  "homepage": "https://github.com/prominence-chan/provenance",
  "author": {
    "name": "prominence-chan",
    "email": "noreply@prominence.dev"
  },
  "build": {
    "appId": "dev.prominence.provenance",
    "productName": "Provenance",
    "copyright": "Provenance contributors",
    "directories": {
      "output": "release",
      "buildResources": "design/icon"
    },
    "files": [
      "dist/**",
      "build-electron/**",
      "package.json",
      "!**/node_modules/**",
      "!build-electron/**/*.map"
    ],
    "extraMetadata": {
      "main": "build-electron/main.cjs"
    },
    "extraResources": [
      {
        "from": "vendor/browser",
        "to": "browser"
      },
      {
        "from": "vendor/router",
        "to": "router",
        "filter": [
          "**/*",
          "!.python-stamp"
        ]
      },
      {
        "from": "vendor/agent",
        "to": "agent",
        "filter": [
          "provenance",
          "provenance.exe",
          "codex-code-mode-host",
          "codex-code-mode-host.exe",
          "VERSION.json"
        ]
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "design/icon/Provenance.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "Provenance ${version}",
      "artifactName": "Provenance-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "design/icon/Provenance.ico",
      "artifactName": "Provenance-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Provenance-${version}-${arch}-setup.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "design/icon/icon-512.png",
      "category": "Development",
      "maintainer": "prominence-chan <noreply@prominence.dev>",
      "artifactName": "Provenance-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  }
}
