{
  "name": "provenance-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Codex-desktop-style web UI for Provenance, driving `provenance app-server` over a local WebSocket bridge.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node server/main.ts --open",
    "start": "node server/main.ts --prod",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "gen:protocol": "node scripts/gen-protocol.ts",
    "smoke": "node scripts/smoke.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
