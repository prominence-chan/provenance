#!/usr/bin/env bash
# Open Provenance. Symlinked into ~/.local/bin/provenance-ui. New threads
# default to the directory you run this from.
#
# If the desktop app is installed (/Applications/Provenance.app or
# ~/Applications), opens it (or focuses it and starts a new thread here).
# Otherwise, or with --web, runs the web UI (dev server + app-server bridge).
#
#   provenance-ui                  # the app, or the web UI if it isn't installed
#   provenance-ui --web            # the web UI in your browser
#   NO_OPEN=1 provenance-ui --web  # don't open a browser tab
#   PORT=5180 provenance-ui --web
set -euo pipefail

web=""
for arg in "$@"; do
  case "$arg" in
    --web) web=1 ;;
    -h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "provenance-ui: unknown option $arg" >&2; exit 2 ;;
  esac
done

if [ -z "$web" ]; then
  for app in "${PROVENANCE_APP:-/Applications/Provenance.app}" "$HOME/Applications/Provenance.app"; do
    if [ -d "$app" ]; then
      # -n: if it's already running, the new instance hands --cwd to it and exits.
      exec open -n -a "$app" --args --cwd "$PWD"
    fi
  done
fi

# Resolve the real script location through the symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
ui_dir="$(cd -P "$(dirname "$src")/.." && pwd)"
port="${PORT:-5173}"

if curl -fsS "http://127.0.0.1:${port}/api/info" >/dev/null 2>&1; then
  echo "Provenance UI already running on http://localhost:${port}"
  [ -z "${NO_OPEN:-}" ] && open "http://localhost:${port}"
  exit 0
fi

# If the ChatGPT-web provider is on in provenance-core, say so when its login is missing or expired
# (silent otherwise; never blocks the launch).
if command -v provenance-core >/dev/null 2>&1; then
  provenance-core webstatus --boot 2>/dev/null || true
fi

export PROVENANCE_UI_CWD="${PROVENANCE_UI_CWD:-$PWD}"
cd "$ui_dir"
[ -d node_modules ] || npm install
exec node server/main.ts --open
